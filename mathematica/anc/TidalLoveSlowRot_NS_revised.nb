Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"**", "**", "**"}], "*****)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"POLYTROPIC", "=", "1"}], ";", 
    RowBox[{"rulePOLY", "=", 
     RowBox[{"{", 
      RowBox[{
