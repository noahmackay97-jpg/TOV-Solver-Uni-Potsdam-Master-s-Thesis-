      RowBox[{"4.92549232189886339689643862", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "6"}]]}]]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Solar", " ", "mass", " ", "units"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meter", "=", 
     RowBox[{
      FractionBox["1", 
