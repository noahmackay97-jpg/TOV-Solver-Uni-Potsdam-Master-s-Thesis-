Cell[CellGroupData[{

Cell["Fitting functions for the rotational Love numbers", "Subsubsection",
 CellChangeTimes->{{3.65027056040274*^9, 3.650270561532102*^9}, {
  3.650783717414353*^9, 3.650783735350243*^9}, {3.650783855806055*^9, 
  3.6507838559418793`*^9}, {3.650783925709461*^9, 
  3.650783961605599*^9}},ExpressionUUID->"5e1c6448-f117-4dbd-9adb-\
f4d3ce7c941a"],

Cell[TextData[{
 "For a given function X, we use the fitting function Log[X] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "i"], 
     SuperscriptBox[
      RowBox[{
       SubscriptBox["a", "i"], "(", 
       RowBox[{"Log", "[", "Ibar", "]"}], ")"}], "i"]}], ",", " ", 
    RowBox[{
    "where", " ", "Ibar", " ", "is", " ", "the", " ", "dimensionless", " ", 
     "moment", " ", "of", " ", 
     RowBox[{
      RowBox[{"inertia", " ", "[", "1", "]"}], "."}]}]}], TraditionalForm]],
  ExpressionUUID->"be85892d-22dc-4c0f-81cd-f094b1bde1c7"]
}], "Text",
 CellChangeTimes->{{3.650784101124855*^9, 3.650784150902615*^9}, {
  3.650784451491857*^9, 
  3.65078446192388*^9}},ExpressionUUID->"02d0880c-8f76-46bb-bc3b-\
da56e54d9d67"],

