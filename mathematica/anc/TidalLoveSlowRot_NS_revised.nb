Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]KM", "[", "L_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss", "=", 
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"g03s", ",", "L"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ii0", "=", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], 
         RowBox[{"Conjugate", "[", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"SphericalHarmonicY", "[", 
             RowBox[{"L", ",", "0", ",", "\[Theta]", ",", "\[CurlyPhi]"}], 
             "]"}], ",", "\[Theta]"}], "]"}], "]"}], 
         FractionBox["ss", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]v", "=", 
      RowBox[{"\[Epsilon]p", 
       RowBox[{"{", 
        RowBox[{
        "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4", 
         ",", "\[Alpha]5"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]sv", "=", 
      RowBox[{"\[Epsilon]p", 
       RowBox[{"{", 
        RowBox[{
        "\[Alpha]s1", ",", "\[Alpha]s2", ",", "\[Alpha]s3", ",", "\[Alpha]s4",
          ",", "\[Alpha]s5"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"coeff", "=", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["M", "2"]], ",", 
        RowBox[{"-", 
         FractionBox["\[Pi]", 
          RowBox[{"288", " ", 
           SuperscriptBox["M", "3"]}]]}], ",", 
        RowBox[{"-", 
         FractionBox["\[Pi]", 
          RowBox[{"2048", " ", 
           SuperscriptBox["M", "4"]}]]}], ",", 
        RowBox[{"-", 
         FractionBox["\[Pi]", 
          RowBox[{"12800", " ", 
           SuperscriptBox["M", "5"]}]]}], ",", 
        FractionBox["1", 
         SuperscriptBox["M", "6"]]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ii", "=", 
      RowBox[{
       RowBox[{"coeff", "[", 
        RowBox[{"[", "L", "]"}], "]"}], "ii0"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Or", "[", 
        RowBox[{
         RowBox[{"L", "\[Equal]", "1"}], ",", 
         RowBox[{"L", "\[Equal]", "5"}]}], "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"\[Delta]K0", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Delta]K1", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"ii", ",", "\[Epsilon]a"}], "]"}], "/.", 
            RowBox[{"\[Epsilon]a", "\[Rule]", "0"}]}], ")"}], 
          "\[Epsilon]a"}]}]}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Delta]K0", "=", 
         RowBox[{
          FractionBox["ii", 
           RowBox[{"\[Alpha]sv", "[", 
            RowBox[{"[", "L", "]"}], "]"}]], "/.", 
          RowBox[{"\[Epsilon]a", "\[Rule]", "0"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Delta]K1", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"ii", ",", "\[Epsilon]a"}], "]"}], "/.", 
            RowBox[{"\[Epsilon]a", "\[Rule]", "0"}]}], ")"}], 
          "\[Epsilon]a"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[Delta]K0", ",", "\[Delta]K1"}], "}"}]}], 
    "\[IndentingNewLine]", ")"}]}], ";"}]], "Input",
