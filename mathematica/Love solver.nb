            RowBox[{"y", "^", "2"}]}], "-", 
           RowBox[{"60", 
            RowBox[{"y", "^", "3"}]}], "+", 
           RowBox[{"15", 
            RowBox[{"y", "^", "4"}]}]}], ")"}]}], "+", 
        RowBox[{"15", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", "-", "2"}], ")"}], "^", "2"}], 
         RowBox[{"(", 
          RowBox[{"y", "-", "1"}], ")"}], 
         RowBox[{"y", "^", "2"}], "*", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
           RowBox[{"2", "/", "y"}]}], "]"}]}]}], ")"}], "g3"}]}], ")"}], "/", 
   
   RowBox[{"(", 
    RowBox[{"2", "y", 
     RowBox[{"(", 
      RowBox[{"y", "-", "2"}], ")"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h30", "[", "y_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "M"}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "64"}], 
       RowBox[{"y", "^", "3"}], 
       RowBox[{"(", 
        RowBox[{"8", "-", 
         RowBox[{"10", "y"}], "+", 
         RowBox[{"3", 
          RowBox[{"y", "^", "2"}]}]}], ")"}], "as3"}], "+", 
      RowBox[{"3", 
       RowBox[{"(", 
        RowBox[{"8", "+", 
         RowBox[{"20", "y"}], "+", 
         RowBox[{"60", 
          RowBox[{"y", "^", "2"}]}], "-", 
