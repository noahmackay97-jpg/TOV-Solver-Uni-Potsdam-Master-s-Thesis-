            RowBox[{"3", 
             RowBox[{"y", "^", "2"}]}]}], ")"}], 
          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            RowBox[{"2", "/", "y"}]}], "]"}]}]}], ")"}], "g32"}]}], ")"}]}]}],
   "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g2", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"5", "/", "4"}], ")"}]}], "k2", "*", 
    RowBox[{"c", "^", 
