          RowBox[{"(", 
           RowBox[{"y", "-", "2"}], ")"}], "^", "2"}], 
         RowBox[{"(", 
          RowBox[{"y", "-", "1"}], ")"}], 
         RowBox[{"y", "^", "2"}], "*", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
           RowBox[{"2", "/", "y"}]}], "]"}]}]}], ")"}], "g3"}]}], ")"}], "/", 
   
   RowBox[{"(", 
    RowBox[{"2", "y", 
     RowBox[{"(", 
      RowBox[{"y", "-", "2"}], ")"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h30", "[", "y_", "]"}], ":=", 
