          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            RowBox[{"2", "/", "y"}]}], "]"}]}]}], ")"}], "gs3"}]}], ")"}], 
    "/", 
    RowBox[{"(", 
     RowBox[{"192", "y"}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dh30", "[", "y_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"M", "*", "chi"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"6720", 
         RowBox[{"y", "^", "2"}]}], ")"}]}], ")"}]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "128"}], 
