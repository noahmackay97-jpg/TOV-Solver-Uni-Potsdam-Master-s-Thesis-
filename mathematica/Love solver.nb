    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox["55", "3"], " ", 
       SqrtBox[
        FractionBox["5", "7"]], " ", 
       RowBox[{"(", 
        RowBox[{"k2", "*", 
