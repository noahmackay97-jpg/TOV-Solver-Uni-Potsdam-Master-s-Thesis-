Cell[BoxData[{
 RowBox[{
  RowBox[{"H20", "[", "y_", "]"}], ":=", 
  RowBox[{
   RowBox[{"a2", "*", "y", 
    RowBox[{"(", 
     RowBox[{"y", "-", "2"}], ")"}]}], "-", 
   RowBox[{"g2", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "3"}], "+", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", "-", "y"}], ")"}]}], "-", 
      RowBox[{"1", "/", "y"}], "+", 
      RowBox[{"3", "y"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", "/", "2"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"y", "-", "2"}], ")"}], "y", "*", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", 
         RowBox[{"2", "/", "y"}]}], "]"}]}]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H30", "[", "y_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", 
